# Database
# For local demo (no Postgres needed), SQLite is used automatically if DATABASE_URL is unset.
# For deployment, point to a hosted PostgreSQL instance, e.g.:
# DATABASE_URL=postgresql://user:password@host:5432/packaging_db
DATABASE_URL=sqlite:///./packaging_demo.db

# JWT
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM (OpenAI-style API). If left blank, the app falls back to a
# template-based explanation generator so the demo still works offline.
LLM_API_KEY=
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# CORS
FRONTEND_ORIGIN=http://localhost:5173
